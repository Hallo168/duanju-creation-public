      "canonical_request_shape": {
        "model": "seedance-2.0-noface",
        "input": {
          "prompt": "<视频提示词，UTF-8 字符串>",
          "image_references": [
            "https://example.com/grid-or-character-1.png",
            "https://example.com/character-or-scene-2.png"
